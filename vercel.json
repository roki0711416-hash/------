{
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "10 19 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 20 * * 0"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.slokasukun.com"
        }
      ],
      "destination": "https://slokasukun.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
}
